{
  "name": "@agentic-db/cli",
  "version": "0.4.0",
  "description": "CLI for agentic-db database operations",
  "author": "Constructive <developers@constructive.io>",
  "license": "MIT",
  "main": "index.js",
  "module": "esm/index.js",
  "types": "index.d.ts",
  "bin": {
    "agentic-db": "./generated/cli/index.js"
  },
  "publishConfig": {
