{
  "name": "@agentic-db/cli",
  "version": "1.5.0",
  "description": "CLI for agentic-db database operations",
  "author": "Constructive <developers@constructive.io>",
  "license": "MIT",
  "main": "src/index.js",
  "module": "esm/src/index.js",
  "types": "src/index.d.ts",
  "bin": {
    "agentic-db": "src/index.js"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "scripts": {
    "clean": "makage clean",
    "prepack": "npm run build",
    "build": "makage build",
    "generate": "tsx src/generate.ts",
    "start": "tsx src/index.ts"
  },
  "dependencies": {
    "@0no-co/graphql.web": "^1.2.0",
    "@agentic-kit/ollama": "^1.0.3",
    "@constructive-io/graphql-types": "^3.5.0",
    "appstash": "^0.7.0",
    "gql-ast": "^3.4.2",
    "graphql": "16.13.0",
    "inquirerer": "^4.7.0",
    "nested-obj": "^0.1.5"
  },
  "devDependencies": {
    "@agentic-db/schemas": "workspace:*",
    "@constructive-io/graphql-codegen": "^4.30.2",
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.5",
    "makage": "^0.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
